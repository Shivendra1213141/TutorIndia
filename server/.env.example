# Copy to .env and fill in
PORT=5000
MONGO_URI=mongodb://localhost:27017
# Use a long random string in production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (only needed when the frontend runs on a different domain)
CLIENT_ORIGIN=http://localhost:5173

# First admin account (created automatically on first start)
ADMIN_NAME=Roopsagar
ADMIN_EMAIL=admin@tutorsetu.in
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=9000000000

# Initial values. After first start, change these from Admin → Settings.
REGISTRATION_FEE=300
UPI_ID=yourname@upi
UPI_NAME=TutorSetu
