# Copy to .env and fill in
NODE_ENV=development
# Must match the Vite dev proxy target in client/vite.config.js (5050)
PORT=5050
MONGO_URI=mongodb://localhost:27017/tutorsetu
# Use a long random string in production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required when NODE_ENV=production (server refuses to start with the default).
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (only needed when the frontend runs on a different domain)
CLIENT_ORIGIN=http://localhost:5173
# Folder for uploaded files, relative to server/
UPLOAD_DIR=uploads

# SEO
# Public address of the site, no trailing slash (e.g. https://tutorsetu.in). Empty = use the request's host.
SITE_URL=
# Google Search Console verification code (content of the meta tag)
GOOGLE_SITE_VERIFICATION=

# First admin account (created automatically on first start)
# Change ADMIN_PASSWORD before the first production start.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@tutorsetu.in
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=9000000000

# Initial values. After first start, change these from Admin → Settings.
REGISTRATION_FEE=300
UPI_ID=yourname@upi
UPI_NAME=TutorSetu
