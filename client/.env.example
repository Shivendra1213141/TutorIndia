# Copy to .env and fill in. Vite bakes these into the build, so never put secrets here.

# Base URL of the API server, no trailing slash (e.g. https://api.tutorsetu.in).
# Leave empty when the API is served from the same domain (default), or in dev
# where Vite proxies /api and /uploads to http://localhost:5050.
VITE_API_URL=
